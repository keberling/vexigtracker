HOST=0.0.0.0
PORT=3000
NODE_ENV=production
DATA_DIR=/data
APP_URL=https://igtracker.apps.vexitey.com

# Dashboard password (required in production)
APP_PASSWORD=

# Bearer token for browser-agent ingest (Instagram Manager / Grok Bot)
# Set this in Coolify to the same value as IGTRACKER_INGEST_API_KEY you gave the agent.
INGEST_API_KEY=

# Giveaway drawing window (America/Chicago calendar dates)
TZ=America/Chicago
GIVEAWAY_WINDOW_START=2026-09-13
GIVEAWAY_WINDOW_END=2026-09-15
