# Local defaults. In Coolify, set these as environment variables instead.

# Bind 127.0.0.1 locally. Docker/Coolify image already uses 0.0.0.0:3000.
HOST=127.0.0.1
PORT=3847
NODE_ENV=development
DATA_DIR=data

# Public URL of the Coolify service, no trailing slash.
# Used to build the Instagram OAuth callback if IG_REDIRECT_URI is unset.
APP_URL=https://igtracker.apps.vexitey.com

# Required in production — this dashboard is otherwise open to the internet.
APP_PASSWORD=

# Instagram API with Instagram Login
# Meta App Dashboard → Instagram → API setup with Instagram business login
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=https://igtracker.apps.vexitey.com/auth/callback
IG_API_VERSION=v21.0
